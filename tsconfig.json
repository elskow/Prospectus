{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "allowJs": true,
    "types": ["bun"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "#app": ["./node_modules/nuxt/dist/app"],
      "#app/*": ["./node_modules/nuxt/dist/app/*"],
      "#imports": ["./.nuxt/imports.d.ts"],
      "~/*": ["./app/*"],
      "@/*": ["./app/*"],
      "@src/*": ["./src/*"],
      "@server/*": ["./server/*"],
      "@app/*": ["./app/*"],
      "~~": ["./"],
      "@@": ["./"]
    }
  },
  "include": [
    ".nuxt/imports.d.ts",
    ".nuxt/types/**/*.d.ts",
    "node_modules/nuxt/types.d.mts",
    "nuxt.config.ts",
    "prospectus.config.ts",
    "src/**/*.ts",
    "server/**/*.ts",
    "workers/**/*.ts",
    "mcp/**/*.ts",
    "scripts/**/*.ts",
    "app/**/*.ts",
    "app/**/*.vue",
    "drizzle.config.ts"
  ]
}
