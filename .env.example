# Prospectus environment — copy to .env and fill in.
# NEVER commit .env. All credentials are either here (infra bootstrap only)
# or entered via the web UI (stored encrypted in Postgres).

# ── Postgres ─────────────────────────────────────────────
POSTGRES_USER=prospectus
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=prospectus
# Host ports published by compose; change when 5432/8888 are already taken.
POSTGRES_PORT=5432
SEARXNG_PORT=8888

# ── Run memory guard ─────────────────────────────────────
# A run pauses itself (instead of dying) once its JS heap reaches this many MB.
RUN_MEMORY_CEILING_MB=1400

# ── Dev server heap ceiling ──────────────────────────────
# Wired via NODE_OPTIONS in package.json scripts (--max-old-space-size=2048).
# Caps the worker heap so a runaway run fails fast instead of growing
# until the OS kills the process. Adjust in package.json, not here.

# App-side connection string (what the Nuxt/Mastra app uses)
DATABASE_URL=postgres://prospectus:change_me_dev@localhost:5432/prospectus

# ── 9Router (self-hosted LLM gateway) ────────────────────
# Generate with: openssl rand -hex 32
NINE_ROUTER_JWT_SECRET=
NINE_ROUTER_INITIAL_PASSWORD=
NINE_ROUTER_API_KEY_SECRET=
# Internal URL used by the app (compose network)
NINE_ROUTER_URL=http://localhost:20128/v1
# API key the app uses to call the gateway (service key from the 9Router dashboard)
NINE_ROUTER_API_KEY=

# ── App ──────────────────────────────────────────────────
# AES-256-GCM key for encrypting credentials stored in the DB (web-UI entered).
# Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=
# Session/auth secret
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
SCRAPLING_MCP_AUTH_TOKEN=
SCRAPLING_MCP_URL=http://127.0.0.1:9701/mcp
# Egress proxy host:port for scrapling (socks5 via the warp compose service).
# Required for container DNS: external names only resolve through the proxy.
SCRAPING_PROXY_URL=warp:1080
SCRAPLING_PROXY_URL=warp:1080

# Egress proxy for the Google Maps worker. Google flags a residential IP after
# a burst of Maps searches (403 "Sorry..." page); routing through the warp
# container gives a clean Cloudflare egress. Chromium only accepts the
# socks5:// scheme (not socks5h://). Leave empty to go direct.
SCRAPE_PROXY_URL=socks5://127.0.0.1:1080

# ── OpenObserve (dev only; leave OTLP_ENDPOINT unset in prod to disable span export) ──
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=change_me_dev
# OTLP_ENDPOINT=http://127.0.0.1:5080/api/default/v1/traces

# ── Scraper daemon (one Chromium pool shared by every run worker) ──
# MAPS_DAEMON_URL=tcp://127.0.0.1:9710
# MAPS_DAEMON_PORT=9710
# MAPS_DAEMON_AUTOSTART=false

# ── MCP server (stdio; use from an external agent such as opencode or Hermes) ──
# PROSPECTUS_MCP_USER_EMAIL=owner@example.com

# ── Run workers (each campaign run executes in its own process; must resolve to bun) ──
BUN_BIN=bun

# ── Email verification (optional; preferred over env via Settings → Web search) ──
# ZeroBounce or NeverBounce API key. Without a key, email verification falls
# back to MX-level checks only (SMTP verification is blocked on this network).
EMAIL_VERIFIER_API_KEY=
EMAIL_VERIFIER_PROVIDER=zerobounce
